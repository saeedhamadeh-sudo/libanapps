{
  "name": "libanapps-desktop",
  "productName": "LibanApps",
  "version": "1.1.0",
  "description": "LibanApps desktop app — silent receipt printing on the computer's printers",
  "main": "main.js",
  "author": "LibanApps",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.libanapps.desktop",
    "productName": "LibanApps",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "LibanApps" },
    "portable": { "artifactName": "LibanApps-Portable-${version}.exe" }
  }
}
